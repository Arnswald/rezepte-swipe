# ── Rezepte-Quelle ────────────────────────────────────────────
# Absoluter Pfad zum Rezept-Ordner (im Container der read-only Mount).
# Lokal: zeig direkt auf deinen Vault-Ordner.
OBSIDIAN_RECIPES_PATH=/app/recipes
OBSIDIAN_IMAGES_PATH=/app/recipes/Bilder

# Alternativ (statt der zwei Zeilen oben): ganzer Vault gemountet
# OBSIDIAN_VAULT_PATH=/app/obsidian

# ── Schreibbarer Datenordner (Bild-Cache + Vorschläge) ────────
DATA_DIR=./data

# ── Admin-Statistik (/admin) ──────────────────────────────────
# PIN, mit dem du unter /admin die Auswertung siehst (wer mag was).
# Ohne gesetzten PIN ist die Admin-Seite gesperrt.
ADMIN_PIN=changeme

# ── Optional: Vorschläge an n8n schicken (Phase 3) ────────────
# Wenn gesetzt, wird jeder Rezept-Vorschlag zusätzlich an diesen
# n8n-Webhook gePOSTet (→ Telegram / Obsidian-Inbox).
# N8N_SUGGEST_WEBHOOK=https://n8n.deinserver.de/webhook/rezept-vorschlag

# ── Zeitzone ──────────────────────────────────────────────────
TZ=Europe/Berlin
